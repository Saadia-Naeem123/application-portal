# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slashes).
# In production, set this to your Vercel domain(s), e.g.:
# CLIENT_URL=https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/university_system?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP) - if left blank, emails are logged to the console instead of sent
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="University System <no-reply@university.edu>"

# SMS (Phase 7) - provider-agnostic HTTP API (bearer token + {to, from, body}
# JSON payload). If SMS_API_URL/SMS_API_KEY are left blank, SMS messages are
# logged to the console instead of sent, same as email above.
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=

# Token expiry
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1

# Phase 6 — Deadline, Reminder & Escalation Engine
# Cron schedule for the hourly "check pending applications" sweep (reminders
# + escalation). Set SCHEDULER_ENABLED=false to disable the in-process
# scheduler entirely (e.g. if you run multiple API instances behind a load
# balancer and only want one of them running the sweep).
SCHEDULER_ENABLED=true
SCHEDULER_CRON="0 * * * *"
